NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPTIMIZER_WEBHOOK_URL=

# Jeden publiczny host UAT używany przez wejście do aplikacji i cały OAuth Google.
# Nie wpisuj tutaj technicznego adresu pojedynczego deploymentu Vercel.
NEXT_PUBLIC_CANONICAL_APP_ORIGIN=https://uat.szafunek.pl
GOOGLE_OAUTH_REDIRECT_ORIGIN=https://uat.szafunek.pl

# Client ID może być publiczny. Client secret ustaw wyłącznie jako sekret środowiska UAT.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
